{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "closed"
      ],
      "default": "open"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "enum": [
              "customer",
              "admin"
            ]
          },
          "body": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "subject",
    "customer_name"
  ]
}