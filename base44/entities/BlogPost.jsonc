{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "author": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ]
}