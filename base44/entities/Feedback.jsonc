{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "category": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "resolved"
      ],
      "default": "new"
    }
  },
  "required": [
    "message"
  ]
}