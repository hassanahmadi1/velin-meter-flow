{
  "name": "ChangelogEntry",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "improvement",
        "fix"
      ],
      "default": "feature"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ]
}