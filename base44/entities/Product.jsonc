{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "compare_price": {
      "type": "number",
      "default": 0
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived"
      ],
      "default": "active"
    },
    "image_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "sales": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}